# Supabase Configuration
# Получите эти значения из личного кабинета Supabase:
# 1. Зайдите в https://supabase.com/dashboard
# 2. Выберите ваш проект
# 3. Перейдите в Settings -> API

# URL проекта (без "/rest/v1/" в конце)
SUPABASE_URL=https://bqaejvutckdthcgxzwje.supabase.co

# Anon key (публичный ключ для клиентского доступа)
# Находится в Settings -> API -> Project API keys -> anon public
SUPABASE_KEY=sb_publishable_PrLnYTbErX-nMixZcvdvbA_GNz_7bES

# Service role key (приватный ключ для серверного доступа)
# ВНИМАНИЕ: Не используйте в клиентском коде! Только на сервере.
# Находится в Settings -> API -> Project API keys -> service_role
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
