dist/
build/
target/

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Database
tasks.db

# Coverage
coverage/
htmlcov/
.coverage

# MyPy
.mypy_cache/

# Pytest
.pytest_cache/

# Gradle
.gradle/

# Android build artifacts
*.apk
*.aar
*.dex
*.jar

# Android IDE
.gradle/
local.properties
.settings/
bin/
gen/
out/

# Temporary files
*.tmp
*~
\#*\#
```